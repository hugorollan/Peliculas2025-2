# TMDb API Key
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Server Port (optional)
PORT=3000

# MongoDB Connection String
# For local development: mongodb://localhost:27017/peliculas2025
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/peliculas2025
MONGODB_URI=mongodb://localhost:27017/peliculas2025

# JWT Secret Key (change this to a random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Token Expiration (e.g., '1d', '7d', '30d')
JWT_EXPIRES_IN=7d
